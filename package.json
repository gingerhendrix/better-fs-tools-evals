{
  "name": "better-fs-tools-evals",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/scorers/*",
      "packages/sources/*"
    ],
    "catalog": {
      "@ai-sdk/openai": "4.0.78",
      "@better-fs-tools/ai-sdk": "0.3.0",
      "@better-fs-tools/fs": "0.3.0",
      "@better-fs-tools/node": "0.3.0",
      "@better-fs-tools/read": "0.3.0",
      "@better-fs-tools/shell": "0.3.0",
      "@better-fs-tools/write": "0.3.0",
      "@types/bun": "^1.3.10",
      "ai": "^7.0.77",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "eval": "bun run apps/cli/src/cli.ts",
    "view": "bun run apps/viewer/src/main.ts",
    "fixtures:explicit-edit": "bun run packages/sources/explicit-edit/src/export.ts",
    "check": "bun run format:check && bun run lint && bun run check:deps && bun run typecheck && bun run test",
    "check:deps": "bun run scripts/check-deps.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
